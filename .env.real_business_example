# ========================================
# AI Entrepreneur - REAL BUSINESS MODE
# ========================================
# This configuration enables REAL payments and deployments!
# Copy this to .env and fill in your actual credentials.

# ========================================
# REAL BUSINESS MODE (IMPORTANT!)
# ========================================
REAL_BUSINESS_MODE=true          # Set to true to enable real business operations
USE_REAL_PAYMENTS=true           # Set to true to process real payments
USE_REAL_DEPLOYMENT=true         # Set to true to deploy to real cloud

# ========================================
# RAZORPAY PAYMENT GATEWAY
# ========================================
# Get these from: https://dashboard.razorpay.com/app/keys
RAZORPAY_ENABLED=true
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_ACCOUNT_NUMBER=your_razorpay_account_number
RAZORPAY_CALLBACK_URL=http://localhost:8000/api/payment/callback

# ========================================
# DIGITALOCEAN CLOUD DEPLOYMENT
# ========================================
# Get API token from: https://cloud.digitalocean.com/account/api/tokens
DIGITALOCEAN_ENABLED=true
DIGITALOCEAN_API_TOKEN=your_digitalocean_api_token_here
DIGITALOCEAN_SSH_KEY_ID=your_ssh_key_id  # Optional, for SSH access
DIGITALOCEAN_DEFAULT_REGION=blr1         # blr1=Bangalore, nyc1=New York, sgp1=Singapore

# ========================================
# OLLAMA CONFIGURATION
# ========================================
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gpt-oss:latest

# ========================================
# BUSINESS PARAMETERS
# ========================================
INITIAL_CAPITAL=1000.0           # Starting capital (simulated, but tracked)
RISK_TOLERANCE=0.7               # 0-1, higher = more aggressive
MIN_PROFIT_MARGIN=0.15           # Minimum 15% profit margin required
OPPORTUNITY_SCAN_INTERVAL_MINUTES=30

# ========================================
# AGENT SETTINGS
# ========================================
MAX_CONCURRENT_AGENTS=10
AGENT_MIN_SUCCESS_RATE=0.4       # Agents below 40% success rate get terminated
AGENT_MAX_IDLE_MINUTES=60        # Agents idle >60 min get terminated
AGENT_EVALUATION_INTERVAL=3      # Evaluate agents every 3 cycles

# ========================================
# WEB DASHBOARD
# ========================================
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000

# ========================================
# DATABASE
# ========================================
DATABASE_URL=sqlite:///./entrepreneur_agent.db

# ========================================
# LOGGING
# ========================================
LOG_LEVEL=INFO
DEBUG=false

# ========================================
# SECURITY
# ========================================
API_KEY=your_secure_api_key_here
